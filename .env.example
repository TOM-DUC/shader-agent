# === DeepSeek API ===
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === Shadertoy API（阶段二）===
# 申请地址：https://www.shadertoy.com/myapps
# 没有 key 也能用：fetcher 会回退到内嵌的 seed_shaders 跑通流程
SHADERTOY_API_KEY=

# === HuggingFace 缓存（可选）===
# 不指定则使用默认 ~/.cache/huggingface
# HF_HOME=./data/models

# === 可选：日志级别 ===
LOG_LEVEL=INFO
