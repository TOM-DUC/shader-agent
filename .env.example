# 复制为 .env 后填入真实值。.env 不进版本库。

# ===== DeepSeek（必填）=====
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== Shadertoy（可选）=====
# 没有也能跑：建库时用 `--no-api` 走内置 seed shaders
SHADERTOY_API_KEY=

# ===== Langfuse 可观测性（可选）=====
# 不填这三项时，config.yaml 的 observability.enabled=auto 会让全链路降级为 no-op，
# 现有功能完全不受影响。
# 自托管：把 LANGFUSE_HOST 换成你的实例地址（如 http://localhost:3000）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 环境标签（也可在 config.yaml 的 observability.environment 里配）
LANGFUSE_TRACING_ENVIRONMENT=dev

# ===== DeepEval（可选）=====
# 本项目的评审模型走自带的 DeepSeek 客户端（见 shader_agent/eval/judge_model.py），
# 因此**不需要** OPENAI_API_KEY。
# 关闭 deepeval 的匿名遥测上报：
DEEPEVAL_TELEMETRY_OPT_OUT=YES
# 不使用 Confident AI 云端看板（本项目分数回流到 Langfuse）：
DEEPEVAL_RESULTS_FOLDER=data/reports/deepeval

# ===== 开关 =====
# LLM 响应磁盘缓存（1=开，0=关）
SHADER_AGENT_LLM_CACHE=1
# 强制关闭可观测性（覆盖 config.yaml）：off
# SHADER_AGENT_OBSERVABILITY=off
