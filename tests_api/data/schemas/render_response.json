{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "渲染接口响应",
  "type": "object",
  "required": ["code", "data"],
  "properties": {
    "code": {"const": 0},
    "data": {
      "type": "object",
      "required": ["image_base64", "format", "width", "height", "bytes", "elapsed_ms"],
      "properties": {
        "image_base64": {"type": "string", "minLength": 100},
        "format": {"const": "png"},
        "width": {"type": "integer", "minimum": 16},
        "height": {"type": "integer", "minimum": 16},
        "bytes": {"type": "integer", "minimum": 1},
        "time": {"type": "number"},
        "backend": {"type": "string"},
        "elapsed_ms": {"type": "number", "minimum": 0}
      }
    }
  }
}
